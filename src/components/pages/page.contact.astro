---
import SectionPageHero from "../sections/section.page-hero.astro";
import SectionContactInfo from "../sections/section.contact-info.astro";
import SectionStoreLocations from "../sections/section.store-locations.astro";
import { useTranslations } from "../../lib/utils";

const lang = Astro.props.locale;
const t = useTranslations(lang);
---

<main class="container">
    <SectionPageHero
        backgroundImage="/images/contact-hero-background.webp"
        title={t("section.contact-hero.title")}
        description={t("section.contact-hero.description")}
        locale={lang}
    />
    <SectionContactInfo locale={lang} />
    <SectionStoreLocations locale={lang} />
</main>
