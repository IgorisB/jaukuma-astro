---
import { useTranslations } from "../../lib/utils";
import { LOCATIONS } from "../../lib/constants";

interface Props {
    locale: string;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const apiKey = import.meta.env.PUBLIC_GOOGLE_MAPS_API_KEY || "";

const locationsData = LOCATIONS.map((loc) => ({
    id: loc.id,
    lat: loc.coordinates.lat,
    lng: loc.coordinates.lng,
    name: t(`location.${loc.id}.name`),
    address: t(`location.${loc.id}.address`),
}));
---

<section class="contact-map">
    <div class="contact-map__container">
        <h2 class="contact-map__title section-title">
            {t("section.contact-map.title")}
        </h2>
        <div class="contact-map__wrapper">
            <div id="store-map" class="contact-map__map"></div>
            <button
                id="use-location-btn"
                class="contact-map__locate-btn button-primary-dark"
                type="button"
            >
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="contact-map__locate-icon">
                    <circle cx="12" cy="12" r="3"></circle>
                    <path d="M12 2v4M12 18v4M2 12h4M18 12h4"></path>
                </svg>
                {t("section.contact-map.use-location")}
            </button>
            <p id="map-error" class="contact-map__error" hidden>
                {t("section.contact-map.error")}
            </p>
        </div>
    </div>
</section>

<script define:vars={{ apiKey, locationsData }}>
    window.__JAUKUMA_MAP_CONFIG = { apiKey, locationsData };
</script>

<script>
    async function loadMap() {
        const config = (window as any).__JAUKUMA_MAP_CONFIG;
        if (!config?.apiKey) return;

        const script = document.createElement("script");
        script.src = `https://maps.googleapis.com/maps/api/js?key=${config.apiKey}&libraries=marker&v=weekly`;
        script.async = true;

        script.onload = async () => {
            const { initializeMap, highlightLocation, findNearestStore } = await import("../../scripts/map-controller");

            initializeMap("store-map", config.locationsData);

            const locateBtn = document.getElementById("use-location-btn");
            const errorMsg = document.getElementById("map-error");

            locateBtn?.addEventListener("click", () => {
                locateBtn.setAttribute("disabled", "");
                errorMsg?.setAttribute("hidden", "");

                findNearestStore(
                    config.locationsData,
                    (locationId: string) => {
                        highlightLocation(locationId);
                        window.dispatchEvent(
                            new CustomEvent("highlight-card", { detail: { locationId } })
                        );
                        locateBtn.removeAttribute("disabled");
                    },
                    () => {
                        errorMsg?.removeAttribute("hidden");
                        locateBtn.removeAttribute("disabled");
                    }
                );
            });

            window.addEventListener("highlight-location", ((e: CustomEvent) => {
                highlightLocation(e.detail.locationId);
            }) as EventListener);
        };

        document.head.appendChild(script);
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", loadMap);
    } else {
        loadMap();
    }
</script>

<style>
    .contact-map {
        background-color: var(--color-main-secondary);
        padding: 5rem 2rem;
    }

    .contact-map__container {
        max-width: var(--max-page-width);
        margin: 0 auto;
    }

    .contact-map__title {
        text-align: center;
        margin: 0 0 2rem;
        color: var(--color-main-primary);
    }

    .contact-map__wrapper {
        position: relative;
    }

    .contact-map__map {
        width: 100%;
        height: 31.25rem;
        border-radius: 0.5rem;
        overflow: hidden;
        background-color: var(--color-light);
    }

    .contact-map__locate-btn {
        position: absolute;
        top: 1rem;
        right: 1rem;
        z-index: 1;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.875rem;
        cursor: pointer;
    }

    .contact-map__locate-btn[disabled] {
        opacity: 0.6;
        cursor: not-allowed;
    }

    .contact-map__locate-icon {
        width: 1.25rem;
        height: 1.25rem;
    }

    .contact-map__error {
        margin: 1rem 0 0;
        text-align: center;
        font-family: "Source Sans Pro", sans-serif;
        font-size: 0.875rem;
        color: var(--color-additional-red);
    }

    @media (max-width: 768px) {
        .contact-map {
            padding: 3rem 1.5rem;
        }

        .contact-map__map {
            height: 21.875rem;
        }

        .contact-map__locate-btn {
            position: relative;
            top: auto;
            right: auto;
            margin: 1rem auto 0;
            width: 100%;
            justify-content: center;
        }
    }
</style>
